{
  "name": "thekitchen-agency/craft-age-gate",
  "description": "Use a full featured agegate to protect your site from under-aged visitors.",
  "type": "craft-plugin",
  "keywords": [
    "craft",
    "craftcms",
    "craftcms5",
    "craft-plugin",
    "craft-age-gate"
  ],
  "support": {
    "issues": "https://github.com/thekitchen-agency/TKA-AgeGate/issues",
    "docs": "https://github.com/thekitchen-agency/TKA-AgeGate/wiki"
  },
  "license": "craft",
  "authors": [
    {
      "name": "TheKitchen Agency",
      "homepage": "https://thekitchen.agency",
      "email": "tech@thekitchen.agency"
    }
  ],
  "require": {
    "php": "8.2",
    "craftcms/cms": "^5.8.0",
    "jaybizzle/crawler-detect": "^1.2"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "thekitchenagency\\craftagegate\\": "src/"
    }
  },
  "extra": {
    "name": "AgeGate",
    "handle": "craft-age-gate",
    "changelogUrl": "https://github.com/thekitchen-agency/TKA-AgeGate/blob/main/CHANGELOG.md",
    "class": "thekitchenagency\\craftagegate\\AgeGate",
    "components": {
      "agegateService": "thekitchenagency\\craftagegate\\services\\AgeGateService"
    }
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}